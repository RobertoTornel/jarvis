<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A deliberately dark, low-glare palette: this app is used in a dark room and
         through a notification shade, and a white screen at 2 a.m. is an assault.

         The names below are Material 3 *roles*, not decoration.  Every colour here
         is consumed by themes.xml to fill a role in the scheme, and the components
         (cards, chips, switches, the toolbar) read the roles — so changing the
         accent is one line here and not a hunt through nine layouts.

         One colour law for both front-ends (web panel and this app): dark grey and
         light grey carry all structure and text, and a single pink accent marks
         the assistant and interactive moments.  Pink is never used for a
         destructive or error state. -->

    <!-- The one accent.  Pink, the only accent hue in the law shared with the web
         panel: it reads as "Claire"/"on" against the dark greys and is not an
         alarm colour; accent_dim is the pressed, darker step. -->
    <color name="accent">#FFE562A4</color>
    <color name="accent_dim">#FFCF4B92</color>

    <!-- Surfaces, darkest to lightest. -->
    <color name="bg">#FF131417</color>
    <color name="surface">#FF1B1D21</color>
    <color name="surface_alt">#FF24262B</color>
    <color name="surface_high">#FF2E3138</color>
    <color name="outline">#FF31343A</color>

    <!-- Translucent scrims.  A scrim is not a surface of its own: bg_scrim is
         the law's bg carrying the alpha a layout needs over the live camera
         preview, and scrim is neutral black, the shadow colour the desktop and
         panel also keep neutral rather than tinting with the accent. -->
    <color name="bg_scrim">#CC131417</color>
    <color name="scrim">#99000000</color>

    <!-- Text. -->
    <color name="text">#FFE8EAED</color>
    <color name="text_dim">#FFA8ADB5</color>
    <color name="on_accent">#FF150A12</color>

    <!-- State colours.  The same four the status chip, the status dot and the
         conversation labels use, so "green" means one thing on every screen.
         These keep their own hues — pink is not a state colour. -->
    <color name="ok">#FF4CC38A</color>
    <color name="warn">#FFD9A441</color>
    <color name="error">#FFEF6A6A</color>
    <color name="bad">#FFEF6A6A</color>
    <color name="idle">#FF878D96</color>

    <!-- Who is speaking, in the conversation: the owner in neutral grey, Claire
         in the accent pink. -->
    <color name="you">#FFA8ADB5</color>
    <color name="claire">#FFE562A4</color>

    <!-- Chat surfaces: an owner bubble (neutral grey surface), a Claire bubble
         (dark, subtly pink-tinted surface), and the small print. -->
    <color name="bubble_you">#FF24262B</color>
    <color name="bubble_claire">#FF2B2028</color>
    <color name="bubble_meta">#FF1B1D21</color>
</resources>
