<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat's NoActionBar theme, because the activities are AppCompatActivities
         and an AppCompat activity on a non-AppCompat theme throws at inflation. Dark,
         and carrying this app's own four colours; no Material Components dependency. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/surface</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="RowText">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="MetaText">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
