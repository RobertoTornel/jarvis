    <string name="channel_listening">Listening</string>
    <string name="channel_listening_detail">The ongoing status line shown while the microphone is open. Silent and low priority on purpose.</string>
    <string name="channel_alerts">Alerts</string>
    <string name="channel_alerts_detail">Things you need to notice: a refused token, location services switched off, the microphone taken by a call.</string>
    <string name="channel_capture">Photos taken for Claire</string>
    <string name="channel_capture_detail">A separate, noisier channel for photos the app takes on Claire\'s own request. It is separate so the owner can silence the status line without silencing the camera, and it exists so a photo is never taken invisibly.</string>

