    <!-- Continuous location. -->
    <string name="label_continuous_location">Share location continuously</string>
    <string name="hint_continuous_location">Reports a position to Claire every %1$d seconds while the service runs. Needs location permission and, on Android 10+, “Allow all the time” for the screen-off case.</string>
    <string name="label_location_interval">Report every</string>
    <string name="interval_seconds">%1$d s</string>

    <!-- Autonomous capture. -->
    <string name="label_auto_capture">Take photos when Claire asks</string>
    <string name="hint_auto_capture">Claire can ask through the bridge for one photo. The request is shown in the notification and written into the conversation; nothing is taken while this is off.</string>
    <string name="label_periodic_capture">Also take a photo every…</string>
    <string name="periodic_off">Never</string>
    <string name="periodic_15">15 minutes</string>
    <string name="periodic_30">30 minutes</string>
    <string name="periodic_60">1 hour</string>
    <string name="periodic_180">3 hours</string>

    <!-- Survival. -->
    <string name="section_survival">Keeping it alive</string>
    <string name="label_battery_exempt">Battery: unrestricted</string>
    <string name="hint_battery_exempt">Without this, MIUI freezes the app after a while with the screen off and listening stops. Android\'s own do-not-kill list.</string>
    <string name="label_overlay">Display over other apps</string>
    <string name="hint_overlay">Android 12+ forbids restarting a microphone service from the background. This exemption is the documented way to keep that legal, so the service can come back by itself after a kill.</string>
    <string name="label_watchdog">Re-arm after a kill</string>
    <string name="hint_watchdog">Checks every 15 minutes whether the listening service is still running and starts it again if it is not. Needs one of the two exemptions above to actually succeed in the background.</string>
    <string name="watchdog_on">Armed</string>
    <string name="watchdog_off">Off</string>
    <string name="survival_granted">granted</string>
    <string name="survival_missing">not granted</string>

