<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_settings"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            style="@style/MetaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="The laptop, the port the bridge listens on, and the token from ~/.config/claire/keys.json." />

        <TextView
            style="@style/RowText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_host" />

        <EditText
            android:id="@+id/host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_host"
            android:textColorHint="@color/text_dim"
            android:inputType="textUri"
            android:autofillHints="" />

        <TextView
            style="@style/RowText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_port" />

        <EditText
            android:id="@+id/port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:autofillHints="" />

        <TextView
            style="@style/RowText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_token" />

        <TextView
            android:id="@+id/token_current"
            style="@style/MetaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_token"
            android:textColorHint="@color/text_dim"
            android:inputType="textNoSuggestions"
            android:importantForAutofill="no" />

        <TextView
            style="@style/MetaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_token" />

        <TextView
            style="@style/RowText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_question" />

        <EditText
            android:id="@+id/question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_question"
            android:textColorHint="@color/text_dim"
            android:inputType="textCapSentences" />

        <CheckBox
            android:id="@+id/auto_photo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_auto_photo"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/speak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_speak"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/boot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_boot"
            android:textColor="@color/text" />

        <CheckBox
            android:id="@+id/low_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_battery"
            android:textColor="@color/text" />

        <TextView
            style="@style/RowText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_sensitivity" />

        <Spinner
            android:id="@+id/sensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/MetaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/help_battery" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/action_save_settings"
            android:textColor="@color/accent" />

        <Button
            android:id="@+id/battery_settings"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_battery"
            android:textColor="@color/accent" />

        <Button
            android:id="@+id/clear"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_clear"
            android:textColor="@color/bad" />
    </LinearLayout>
</ScrollView>
